# ==========================================
# CONNECT MARATHA REST API SERVER CONFIG
# ==========================================
PORT=5000
NODE_ENV=development

# JWT Authentication Secret
# REQUIRED IN PRODUCTION: Must be a random, high-entropy secret string at least 32 characters long.
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long

# Development Login Fallback
# Set to 'true' ONLY in local development to allow 'password123' test bypass.
# Automatically disabled and rejected when NODE_ENV=production.
ALLOW_DEV_LOGIN_FALLBACK=false

# Database Seeding
# Optional seed password for local dev accounts (M1001 etc). Seeding is blocked in production.
SEED_DEFAULT_PASSWORD=your_seed_password_here

# ==========================================
# SMTP EMAIL CONFIGURATION (Hostinger / Titan)
# ==========================================
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@connectmaratha.com
SMTP_PASS=your_smtp_password_here
MAIL_FROM="Connect Maratha" <noreply@connectmaratha.com>

# ==========================================
# TIERED RATE LIMITING CONFIGURATION
# ==========================================
# Tier 2: Public Unauthenticated Endpoints (per-IP sliding window)
RATE_LIMIT_PUBLIC_WINDOW_MS=900000   # 15 minutes window (in ms)
RATE_LIMIT_PUBLIC_MAX=100            # Max 100 requests per 15 mins

# Tier 3: Authenticated User Actions (per-user sliding window)
RATE_LIMIT_USER_WINDOW_MS=900000     # 15 minutes window (in ms)
RATE_LIMIT_USER_MAX=600              # Max 600 requests per 15 mins

# Tier 1: Auth Routes (Login, Register, Password Reset)
RATE_LIMIT_AUTH_IP_WINDOW_MS=900000  # 15 minutes window (in ms)
RATE_LIMIT_AUTH_IP_MAX=20            # Max 20 auth attempts per IP per 15 mins

# Auth Routes: Per-Account Exponential Backoff (replaces hard lockout)
RATE_LIMIT_AUTH_ACCOUNT_WINDOW_MS=900000 # 15 minutes window
RATE_LIMIT_AUTH_ACCOUNT_MAX=5            # Max 5 attempts before backoff kicks in
RATE_LIMIT_AUTH_BACKOFF_BASE_SEC=2       # Initial backoff delay (2 seconds)
RATE_LIMIT_AUTH_BACKOFF_MAX_SEC=900      # Maximum backoff cap (900 seconds / 15 mins)
RATE_LIMIT_AUTH_BACKOFF_FACTOR=2.0       # Exponential multiplier (delay = base * factor^(failures - max))
