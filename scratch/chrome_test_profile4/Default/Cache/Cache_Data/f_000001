/* ==========================================================================
   DESKTOP MEGA-DROPDOWN & NAVIGATION UPGRADES
   ========================================================================== */
.nav-dropdown {
  position: relative;
  display: inline-block;
}

.nav-dropdown .dropdown-trigger {
