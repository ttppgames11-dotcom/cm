# Copy to .env (never commit .env). In production set these as real
# environment variables / secrets on the host instead of a file.

NODE_ENV=development
PORT=5000

# PostgreSQL. Local Docker (docker compose up -d) listens on 5442.
# Production: use the managed database's connection string; set PGSSL=true if it requires TLS.
DATABASE_URL=postgresql://cm_user:cm_password@localhost:5442/connect_maratha
PGSSL=false

# Schema changes are applied by `npm run migrate --prefix database`.
# They run automatically outside production; in production only when DB_AUTO_MIGRATE=true.
# DB_AUTO_MIGRATE=false

# REQUIRED in production: long random string (e.g. `openssl rand -hex 48`).
JWT_SECRET=change-me-to-a-long-random-string

# Browsers may only call the API from these origins (comma separated).
# The mobile app does not need CORS.
CORS_ORIGINS=http://localhost:5173

# Set to the number of reverse proxies in front of the API (e.g. 1) so rate limiting sees real client IPs.
# TRUST_PROXY=1

# Google Sign-In: comma-separated OAuth *Web* client IDs allowed to sign in (REQUIRED in production).
GOOGLE_CLIENT_IDS=

# Test-only: disables the general rate limiters for the integration tests. Ignored when NODE_ENV=production.
# DISABLE_RATE_LIMITS=true
