# ==========================================
# CONNECT MARATHA REST API SERVER CONFIG
# ==========================================
PORT=5000
NODE_ENV=development

# JWT Authentication Secret
# REQUIRED IN PRODUCTION: Must be a random, high-entropy secret string at least 32 characters long.
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long

# Development Login Fallback
# Set to 'true' ONLY in local development to allow 'password123' test bypass.
# Automatically disabled and rejected when NODE_ENV=production.
ALLOW_DEV_LOGIN_FALLBACK=false

# ==========================================
# SMTP EMAIL CONFIGURATION
# ==========================================
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@connectmaratha.com
SMTP_PASS=your_smtp_password_here
MAIL_FROM="Connect Maratha" <noreply@connectmaratha.com>

# ==========================================
# TIERED RATE LIMITING CONFIGURATION
# ==========================================
RATE_LIMIT_PUBLIC_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX=100
RATE_LIMIT_USER_WINDOW_MS=900000
RATE_LIMIT_USER_MAX=600
RATE_LIMIT_AUTH_IP_WINDOW_MS=900000
RATE_LIMIT_AUTH_IP_MAX=20
RATE_LIMIT_AUTH_ACCOUNT_WINDOW_MS=900000
RATE_LIMIT_AUTH_ACCOUNT_MAX=5
RATE_LIMIT_AUTH_BACKOFF_BASE_SEC=2
RATE_LIMIT_AUTH_BACKOFF_MAX_SEC=900
RATE_LIMIT_AUTH_BACKOFF_FACTOR=2.0
