# Copy to .env (never commit .env)
PORT=5000
# Local Docker Postgres (docker compose up -d). In production use the managed
# database's connection string and set PGSSL=true if it requires TLS.
DATABASE_URL=postgresql://cm_user:cm_password@localhost:5442/connect_maratha
PGSSL=false
JWT_SECRET=change-me-to-a-long-random-string
