# Copy to deploy/.env on the server (never commit it) and fill in every value.
#   cp env.prod.example .env && chmod 600 .env

DOMAIN=connectmaratha.com
# Let's Encrypt expiry notices go here.
ACME_EMAIL=you@example.com

# Generate with:  openssl rand -hex 24
POSTGRES_PASSWORD=
# Generate with:  openssl rand -hex 48
JWT_SECRET=

# Google Sign-In: the OAuth *Web* client ID (same value passed to the app as GOOGLE_WEB_CLIENT_ID).
GOOGLE_CLIENT_IDS=

# Only needed if a website calls the API from a browser.
CORS_ORIGINS=https://connectmaratha.com
